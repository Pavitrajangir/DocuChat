# MongoDB connection string (MongoDB Atlas free tier, or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/docuchat

# Secret used to sign JWT tokens - use a long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Google Gemini API key (free tier available at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Your deployed frontend URL, used to restrict CORS in production
FRONTEND_URL=

# Port the backend server runs on (Render sets this automatically in production - leave unset there)
PORT=5000
